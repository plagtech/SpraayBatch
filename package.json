{
  "name": "spraay-batch",
  "version": "0.3.3",
  "description": "Batch ERC-20 payouts for AI agents — pay up to 200 recipients in one atomic transaction on Base with any token. Gasless via CDP Paymaster (agents holding only tokens, zero ETH, can pay), non-custodial auto-wallet, and per-agent budget caps. An OpenClaw plugin.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spraay-batch": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plagtech/SpraayBatch.git"
  },
  "bugs": {
    "url": "https://github.com/plagtech/SpraayBatch/issues"
  },
  "homepage": "https://github.com/plagtech/SpraayBatch#readme",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24",
      "minGatewayVersion": "2026.6.34"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "openclaw.plugin.json",
    "reference/spray-contract-abi.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agent",
    "payments",
    "erc-20",
    "base",
    "gasless",
    "paymaster",
    "batch-payout",
    "payroll",
    "non-custodial",
    "viem",
    "x402"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.39.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.34 || >=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
